<% content_for :title, "Reviews" %>

<div class="min-h-screen bg-slate-950 px-4 py-8 text-slate-100 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">

    <!-- Header -->
    <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">AI Review Analyzer</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Customer reviews</h1>
        <p class="mt-2 text-sm text-slate-400">Explore customer feedback, ratings, and AI-powered sentiment insights.</p>
      </div>

      <%= link_to products_path, class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 text-sm font-medium text-slate-300 transition hover:border-slate-600 hover:bg-slate-800 hover:text-white" do %>
        <span>←</span> Back to products
      <% end %>
    </div>

    <!-- Summary -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10 text-2xl text-blue-400">
          ✦
        </div>
        <div>
          <h2 class="font-semibold text-white">All reviews</h2>
          <p class="mt-1 text-sm text-slate-400">Customer experiences across your products</p>
        </div>
      </div>

      <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm font-medium text-slate-300">
        <%= pluralize(@reviews.size, "review") %>
      </span>
    </div>

    <!-- Reviews Grid -->
    <% if @reviews.any? %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">

        <% @reviews.each do |review| %>
          <div class="group flex flex-col rounded-2xl border border-slate-800 bg-slate-900 p-5 transition duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-xl hover:shadow-blue-950/20">

            <!-- Product name -->
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Product</p>
                <h2 class="mt-1 break-words text-lg font-semibold text-white transition group-hover:text-blue-400">
                  <%= review.product.name %>
                </h2>
              </div>

              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-lg text-blue-400">
                ◈
              </div>
            </div>

            <!-- Rating -->
            <% rating = [[review.ratings.to_i, 0].max, 5].min %>
            <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/60 p-3">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <p class="text-xs text-slate-500">Customer rating</p>
                  <div class="mt-1 flex items-center gap-1">
                    <span class="text-lg tracking-wide text-amber-400"><%= "★" * rating %></span><span class="text-lg tracking-wide text-slate-700"><%= "★" * (5 - rating) %></span>
                  </div>
                </div>
                <span class="text-lg font-bold text-white"><%= rating %><span class="text-sm font-medium text-slate-500">/5</span></span>
              </div>
            </div>

            <!-- Review text -->
            <div class="mt-5 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Customer feedback</p>
              <p class="mt-2 whitespace-pre-line break-words text-sm leading-7 text-slate-300"><%= review.review %></p>
            </div>

            <!-- Sentiment -->
            <% if review.sentiment.present? %>
              <% sentiment_style = case review.sentiment.downcase
                when "positive" then "border-emerald-500/20 bg-emerald-500/10 text-emerald-400"
                when "negative" then "border-red-500/20 bg-red-500/10 text-red-400"
                else "border-amber-500/20 bg-amber-500/10 text-amber-400"
              end %>

              <div class="mt-5 border-t border-slate-800 pt-4">
                <p class="mb-2 text-xs font-medium uppercase tracking-wider text-slate-500">AI sentiment</p>
                <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold <%= sentiment_style %>">
                  <span class="mr-2 h-1.5 w-1.5 rounded-full bg-current"></span>
                  <%= review.sentiment.capitalize %>
                </span>
              </div>
            <% end %>

            <!-- AI analysis -->
            <% if review.analysis.present? %>
              <div class="mt-4 rounded-xl border border-violet-500/15 bg-violet-500/5 p-4">
                <div class="flex items-center gap-2">
                  <span class="text-violet-400">✦</span>
                  <h3 class="text-sm font-semibold text-violet-300">AI analysis</h3>
                </div>
                <p class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-slate-400"><%= review.analysis %></p>
              </div>
            <% end %>

            <!-- Date -->
            <div class="mt-5 flex items-center justify-between border-t border-slate-800 pt-4">
              <span class="text-xs text-slate-500">
                <%= review.created_at.strftime("%b %d, %Y") %>
              </span>

              <%= link_to "View product →", product_path(review.product), class: "text-xs font-semibold text-blue-400 transition hover:text-blue-300" %>
            </div>

          </div>
        <% end %>

      </div>
    <% else %>
      <!-- Empty state -->
      <div class="rounded-2xl border border-dashed border-slate-700 bg-slate-900/50 px-6 py-16 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-slate-700 bg-slate-800 text-3xl text-slate-400">
          ☆
        </div>

        <h3 class="mt-5 text-lg font-semibold text-white">No reviews yet</h3>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-400">
          Customer reviews will appear here once people start sharing their experiences.
        </p>

        <%= link_to "Browse products", products_path, class: "mt-6 inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-500" %>
      </div>
    <% end %>

  </div>
</div>