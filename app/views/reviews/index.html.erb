
<% content_for :title, "Reviews" %>

<div class="max-w-6xl mx-auto px-2 py-2">
  <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
    <h1 class="font-bold text-4xl">Reviews</h1>

    <%= link_to "Back to products", products_path,
        class: "rounded-md px-4 py-2 bg-gray-600 hover:bg-gray-400 font-medium" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @reviews.each do |review| %>
        <div class="border rounded-2xl p-5 shadow-sm hover:shadow-md transition">
          <h2 class="text-lg font-bold text-white">
            <%= review.product.name %>
          </h2>

          <div class="flex items-center gap-1 mt-2">
            <span class="text-yellow-400 text-xl">
              <%= "★" * review.ratings.to_i %>
            </span>
            <span class="text-gray-100 text-xl">
              <%= "★" * (5 - review.ratings.to_i) %>
            </span>
            <span class="text-sm text-gray-100 ml-2">
              <%= review.ratings.to_i %>/5
            </span>
          </div>

          <p class="mt-3 text-gray-50">
            <%= review.review %>
          </p>

          <p class="mt-4 text-xs text-gray-50">
            <%= review.created_at.strftime("%B %d, %Y") %>
          </p>
        </div>

    <% end %>
  </div>
</div>
