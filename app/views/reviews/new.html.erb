<% content_for :title, "New review" %>

<div class="min-h-[80vh] bg-black px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">Customer feedback</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-50 sm:text-4xl">Write a review</h1>
        <p class="mt-2 text-sm text-gray-200">Share your experience and help others make a better choice.</p>
      </div>

      <%= link_to "Back", products_path, class: "shrink-0 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-100" %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-100 bg-gray-50/70 px-6 py-5 sm:px-8">
        <h2 class="text-lg font-semibold text-gray-900">Your feedback</h2>
        <p class="mt-1 text-sm text-gray-500">Tell us what you think about this product.</p>
      </div>

      <div class="p-6 sm:p-8 bg-gray-900">
        <%= form_with(model: [@product, @review], class: "space-y-6") do |form| %>
          <div>
            <%= form.label :review, "Your review", class: "mb-2 block text-sm font-semibold text-white" %>
            <%= form.text_area :review, rows: 6, placeholder: "What did you like or dislike about this product?", class: "block w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-white shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" %>
            <p class="mt-2 text-xs text-gray-500">Be honest and helpful. Your feedback matters.</p>
          </div>

          <div>
            <%= form.label :ratings, "Rating", class: "mb-2 block text-sm font-semibold text-gray-700" %>
            <%= form.number_field :ratings, min: 1, max: 5, step: 1, placeholder: "Choose 1–5", class: "block w-full text-white rounded-xl border border-gray-300 px-4 py-3 text-sm shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 sm:max-w-xs" %>
            <p class="mt-2 text-xs text-gray-500">1 = Poor · 5 = Excellent</p>
          </div>

          <div class="border-t border-gray-100 pt-6">
            <%= form.submit "Submit review", class: "w-full cursor-pointer rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20 sm:w-auto" %>
          </div>
        <% end %>
      </div>
    </div>

    <p class="mt-5 text-center text-xs text-gray-400">Thanks for taking the time to share your feedback.</p>
  </div>
</div>