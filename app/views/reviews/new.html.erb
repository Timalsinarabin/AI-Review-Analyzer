<% content_for :title, "New review" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Add review</h1>
    <%= link_to "Back to products", products_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
  <div class="mt-8 mx-auto border rounded-2xl flex flex-col items-center p-6 md:w-1/3">
    <%= form_with(model: [@product, @review], class: "contents") do |form| %>

      <div class="my-5">
        <%= form.label :review %>
        <%= form.text_area :review, rows: 5, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
      </div>

      <div class="my-5">
        <%= form.label :ratings, "Rating (1-5)" %>
        <%= form.number_field :ratings, min: 1, max: 5, step: 1, class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full" %>
      </div>

      <%= form.submit "Submit review", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <% end %>

  </div>
</div>
