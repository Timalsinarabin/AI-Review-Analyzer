
<div class="flex min-h-screen items-center justify-center bg-[#090D18] px-4 py-10 text-slate-100">

  <div class="w-full max-w-md rounded-2xl border border-[#26334A] bg-[#101B33] p-8 shadow-2xl">

    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold tracking-tight">Review Analyzer</h1>
    </div>

    <% if resource.errors.any? %>
      <div class="mb-5 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-300">
        <ul class="list-inside list-disc">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name,
        url: session_path(resource_name)) do |f| %>

      <div class="mb-5">
        <%= f.label :email,
            class: "mb-2 block text-sm font-medium text-slate-200" %>

        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full rounded-lg border border-[#344563] bg-[#090D18] px-4 py-3 text-slate-100 placeholder-slate-500 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
      </div>

      <div class="mb-5">
        <div class="mb-2 flex items-center justify-between">
          <%= f.label :password,
              class: "block text-sm font-medium text-slate-200" %>
        </div>

        <%= f.password_field :password,
            autocomplete: "current-password",
            placeholder: "Enter your password",
            class: "w-full rounded-lg border border-[#344563] bg-[#090D18] px-4 py-3 text-slate-100 placeholder-slate-500 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
            <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?",
                new_password_path(resource_name),
                class: "text-sm text-blue-400 hover:text-blue-300" %>
          <% end %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center gap-2">
          <%= f.check_box :remember_me,
              class: "h-4 w-4 rounded border-slate-600 bg-[#090D18] text-blue-500 focus:ring-blue-500" %>

          <%= f.label :remember_me,
              class: "text-sm text-slate-300" %>
        </div>
      <% end %>

      <div class="mt-6">
        <%= f.submit "Sign In",
            class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-[#101B33]" %>
      </div>

    <% end %>

    <div class="mt-6 border-t border-[#26334A] pt-6 text-center text-sm text-slate-400">
      Don't have an account?

      <%= link_to "Create account",
          new_registration_path(resource_name),
          class: "font-semibold text-blue-400 hover:text-blue-300" %>
    </div>

  </div>
</div>
