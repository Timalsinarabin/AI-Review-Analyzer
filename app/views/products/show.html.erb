 <% content_for :title, "Showing product" %>

<div class="min-h-screen bg-slate-950 px-4 py-8 text-slate-100 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">

    <% if notice.present? %>
      <p class="mb-6 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-400" id="notice">
        <%= notice %>
      </p>
    <% end %>

    <!-- Header -->
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <p class="text-sm font-medium text-blue-400">PRODUCT DETAILS</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          <%= @product.name %>
        </h1>
        <p class="mt-2 text-sm text-slate-400">Product information and customer feedback</p>
      </div>

      <%= link_to products_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:border-slate-600 hover:bg-slate-800 hover:text-white" do %>
        ← Back to products
      <% end %>
    </div>

    <!-- Product Information -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-xl shadow-black/10 sm:p-7">
      <div class="mb-5 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/10 text-xl text-blue-400">
          ◈
        </div>
        <div>
          <h2 class="font-semibold text-white">Product information</h2>
          <p class="text-sm text-slate-400">Overview and product details</p>
        </div>
      </div>

      <div class="text-slate-300">
        <%= render @product %>
      </div>
    </div>

    <!-- AI Analysis -->
    <% if @product.analysis.present? %>
      <div class="my-6 rounded-2xl border border-violet-500/20 bg-gradient-to-br from-violet-500/10 to-slate-900 p-5 sm:p-7">
        <div class="flex items-start gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-xl text-violet-400">
            ✦
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-400">AI-powered insights</p>
            <h2 class="mt-1 text-xl font-bold text-white">Overall customer opinion</h2>
            <p class="mt-3 whitespace-pre-line leading-7 text-slate-300"><%= @product.analysis %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Product Actions -->
    <div class="my-8 flex flex-wrap gap-3">
      <%= link_to "＋ Add a review", new_product_review_path(@product), class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-500/20" %>

      <%= link_to "Edit product", edit_product_path(@product), class: "inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 px-5 py-3 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white" %>

      <%= button_to "Delete product", @product, method: :delete, form_class: "inline-flex", class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-red-500/20 bg-red-500/10 px-5 py-3 text-sm font-medium text-red-400 transition hover:bg-red-500/20", data: { turbo_confirm: "Are you sure you want to delete this product?" } %>
    </div>

    <!-- Customer Reviews Header -->
    <div class="mb-6 flex flex-col justify-between gap-3 border-b border-slate-800 pb-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-sm font-medium text-blue-400">CUSTOMER FEEDBACK</p>
        <h2 class="mt-1 text-2xl font-bold text-white">Customer reviews</h2>
        <p class="mt-2 text-sm text-slate-400">What customers are saying about this product</p>
      </div>

      <span class="inline-flex w-fit items-center rounded-full border border-slate-700 bg-slate-900 px-3 py-1.5 text-sm text-slate-300">
        <%= pluralize(@product.reviews.size, "review") %>
      </span>
    </div>

    <!-- Reviews List -->
    <% if @product.reviews.any? %>
      <div class="space-y-4">
        <% @product.reviews.each do |review| %>
          <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 transition hover:border-slate-700 sm:p-6">

            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Customer rating</p>
                <p class="mt-1 text-xl tracking-wide text-amber-400">
                  <%= "★" * [[review.ratings.to_i, 0].max, 5].min %><span class="text-slate-700"><%= "★" * (5 - [[review.ratings.to_i, 0].max, 5].min) %></span>
                </p>
              </div>

              <% if review.sentiment.present? %>
                <% sentiment_style = case review.sentiment.downcase
                  when "positive" then "border-emerald-500/20 bg-emerald-500/10 text-emerald-400"
                  when "negative" then "border-red-500/20 bg-red-500/10 text-red-400"
                  else "border-amber-500/20 bg-amber-500/10 text-amber-400"
                end %>
                <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold <%= sentiment_style %>">
                  <%= review.sentiment.capitalize %> sentiment
                </span>
              <% end %>
            </div>

            <div class="mt-5 border-t border-slate-800 pt-4">
              <p class="whitespace-pre-line leading-7 text-slate-300"><%= review.review %></p>
            </div>

            <% if review.analysis.present? %>
              <div class="mt-5 rounded-xl border border-violet-500/15 bg-violet-500/5 p-4">
                <div class="mb-2 flex items-center gap-2">
                  <span class="text-violet-400">✦</span>
                  <h3 class="text-sm font-semibold text-violet-300">AI review analysis</h3>
                </div>
                <p class="whitespace-pre-line text-sm leading-6 text-slate-400"><%= review.analysis %></p>
              </div>
            <% end %>

          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-700 bg-slate-900/50 px-6 py-14 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-800 text-2xl text-slate-400">
          ☆
        </div>
        <h3 class="mt-5 text-lg font-semibold text-white">No reviews yet</h3>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-400">
          Be the first to share your experience and help others understand this product.
        </p>
        <%= link_to "Write the first review", new_product_review_path(@product), class: "mt-5 inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-500" %>
      </div>
    <% end %>

  </div>
</div>