<div class="fixed top-4 right-4 z-50">
  <% if flash[:notice].present? %>
    <p id="notice" data-controller="flash" class="rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 font-medium text-emerald-700 transition-opacity duration-300">
      <%= flash[:notice] %>
    </p>
  <% end %>
  <% if flash[:alert].present? %>
    <p id="alert" data-controller="flash" class="rounded-md border border-rose-200 bg-rose-50 px-3 py-2 font-medium text-rose-700 transition-opacity duration-300">
      <%= flash[:alert] %>
    </p>
  <% end %>
</div>