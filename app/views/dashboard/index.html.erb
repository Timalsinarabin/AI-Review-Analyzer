<% content_for :title, "Dashboard" %>

<div class="min-h-screen bg-slate-950 px-4 py-8 text-slate-100 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">
        AI Review Analyzer
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Dashboard
      </h1>
      <p class="mt-2 text-sm text-slate-400">
        Explore customer feedback, ratings, and AI-powered sentiment insights.
      </p>
    </div>

    <!-- Summary -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-5">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10 text-2xl text-blue-400">
          ✦
        </div>

        <div>
          <h2 class="font-semibold text-white">All reviews</h2>
          <p class="mt-1 text-sm text-slate-400">
            Customer experiences across your products
          </p>
        </div>
      </div>

      <span class="rounded-full border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm font-medium text-slate-300">
        <%= pluralize(@total_reviews, "review") %>
      </span>
    </div>

    <!-- Sentiment Cards -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-2xl border border-emerald-500/20 bg-slate-900 p-6 transition hover:border-emerald-500/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Total products</p>
            <h3 class="mt-3 text-3xl font-bold text-white">
              <%= @total_products %>
            </h3>
          </div>

          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-2xl text-emerald-400">
            📦
          </div>
        </div>
      </div>

      <!-- Positive Reviews -->
      <div class="rounded-2xl border border-emerald-500/20 bg-slate-900 p-6 transition hover:border-emerald-500/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Positive Reviews</p>
            <h3 class="mt-3 text-3xl font-bold text-white">
              <%= @total_positive_reviews %>
            </h3>
          </div>

          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/10 text-2xl text-emerald-400">
            ↗
          </div>
        </div>

        <p class="mt-4 text-sm text-emerald-400">
          Customers with positive feedback
        </p>
      </div>

      <!-- Mixed Reviews -->
      <div class="rounded-2xl border border-amber-500/20 bg-slate-900 p-6 transition hover:border-amber-500/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Mixed Reviews</p>
            <h3 class="mt-3 text-3xl font-bold text-white">
              <%= @total_mixed_reviews %>
            </h3>
          </div>

          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 text-2xl text-amber-400">
            ◐
          </div>
        </div>

        <p class="mt-4 text-sm text-amber-400">
          Customers with mixed opinions
        </p>
      </div>

      <!-- Negative Reviews -->
      <div class="rounded-2xl border border-rose-500/20 bg-slate-900 p-6 transition hover:border-rose-500/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">Negative Reviews</p>
            <h3 class="mt-3 text-3xl font-bold text-white">
              <%= @total_negative_reviews %>
            </h3>
          </div>

          <div class="flex h-12 w-12 appearance-none items-center justify-center rounded-xl bg-red-500/10 text-2xl text-red-300 focus:outline-none focus:ring-0">
            ↘
          </div>
        </div>

        <p class="mt-4 text-sm text-rose-400">
          Customers with negative feedback
        </p>
      </div>

    </div>

  </div>
</div>
